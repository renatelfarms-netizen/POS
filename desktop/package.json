{
  "name": "renatel-shop-pos",
  "productName": "Renatel Shop POS",
  "version": "1.0.0",
  "description": "Renatel Shop point of sale for Windows",
  "main": "main.js",
  "author": "Renatel Shop",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.renatelshop.pos",
    "productName": "Renatel Shop POS",
    "copyright": "Renatel Shop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dialogPreload.js",
      "dialog.html",
      "build/icon.ico",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Renatel Shop POS",
      "artifactName": "Renatel-Shop-POS-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.4",
      "@electron/get": "5.1.0",
      "filelist": "2.0.2",
      "@electron/asar": {
        ".": "4.3.1",
        "glob": "14.0.3"
      },
      "dir-compare": {
        "minimatch": "11.0.4"
      },
      "@electron/universal": {
        "@electron/asar": "4.3.1"
      }
    }
  }
}
